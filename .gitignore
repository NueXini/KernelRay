*.zip
node_modules/

# The core and the geo data are supplied by the maintainer, never committed
# (docs/adr/0014): module/bin/{xray,geosite.dat,geoip.dat} -- see module/bin/README.md
module/bin/*
!module/bin/README.md
build/

# Runtime files written on the device (or by a local test run); never ship them.
# User data now lives under module/config/ -- keep only the shipped template
# and the empty scaffolding dirs (nodes/ subscriptions/ webui/ runtime/).
module/logs/
module/config/*
!module/config/config.example.json
!module/config/*/
module/config/nodes/*
module/config/subscriptions/*
module/config/webui/*
module/config/runtime/*
!module/config/*/.gitkeep
