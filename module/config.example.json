{
  "log": {
    "access": "none",
    "error": "/data/adb/modules/kernelray/logs/xray.log",
    "loglevel": "__KERNELRAY_LOGLEVEL__",
    "dnsLog": false
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": "__KERNELRAY_SOCKS_PORT__",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": "__KERNELRAY_HTTP_PORT__",
      "protocol": "http",
      "settings": {}
    }
    ,"__KERNELRAY_TPROXY_INBOUND__"
  ],
  "outbounds": [
    "__KERNELRAY_OUTBOUND__",
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {},
      "streamSettings": {
        "sockopt": {
          "mark": 19282
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
    ,"__KERNELRAY_DNS_OUTBOUND__"
  ]
  ,"dns": "__KERNELRAY_DNS__"
  ,"routing": "__KERNELRAY_ROUTING__"
}
